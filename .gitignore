# ─────────────────────────────────────────────────────────────
# Global ignores — matched at ANY depth (no leading slash),
# so they cover the root and every sub-project (aba-bl, aba-web,
# worker, packages, …) without listing each folder explicitly.
# ─────────────────────────────────────────────────────────────

# Dependencies
node_modules/
.pnpm-store/
.yarn/
.pnp.*

# Build output / compiled artifacts
dist/
build/
out/
.next/
.turbo/
.vercel/
*.tsbuildinfo

# Test / coverage output
coverage/
.nyc_output/

# Caches
.cache/
.eslintcache
.parcel-cache/

# Logs & debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.stackdump

# Environment files (never commit secrets)
.env
.env.*
!.env.example
!.env.sample

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local Claude / tooling state
.claude/scheduled_tasks.lock

# Investor materials (local only)
/investment-application/

# Local notes (not for the repo)
./how-to-test-github-webhook-feature-locally.txt
